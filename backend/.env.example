# Server
PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-HOST.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=change_me_to_a_random_64_char_string

# Instance ID (set differently per container in docker-compose)
INSTANCE_ID=backend-1

# Cloudinary (optional — leave blank to use placeholder images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
